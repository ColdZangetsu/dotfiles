[Unit]
Description=Wallmux wallpaper daemon
Documentation=https://github.com/wallmux/wallmux
After=graphical-session.target awww-daemon.service
Wants=awww-daemon.service
PartOf=graphical-session.target

[Service]
ExecStart=/home/ovi/.local/bin/wallmuxd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
