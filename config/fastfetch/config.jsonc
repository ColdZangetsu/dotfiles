// BORRADOR tema Eclipse (nerozangetsu.com): negro, rojo #ff2448, rosa #ff7a8e, texto #fff1f3, kanji finos.
// Probar:  fastfetch -c ~/.config/fastfetch/config-fable.jsonc      (o ./probar-fable.sh)
// Mismos datos y mismo logo de Nero que config.jsonc; cambian colores, marcos y rótulos.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/caelestia/nero.png",
        "width": 18,
        "height": 9,
        "padding": { "top": 2, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "",
        "key": { "width": 15 },
        "color": { "keys": "38;2;255;122;142", "output": "38;2;255;241;243" },
        "constants": [
            // $1: filo que se apaga (como la línea bajo el logo del sitio)   $2: rojo   $3: rosa   $4: tenue   $5: texto
            "\u001b[38;2;255;36;72m━━━━━━\u001b[38;2;200;28;58m━━━━━━\u001b[38;2;140;20;42m──────\u001b[38;2;90;14;28m──────\u001b[38;2;50;8;16m──────────────────\u001b[0m",
            "\u001b[38;2;255;36;72m",
            "\u001b[38;2;255;122;142m",
            "\u001b[38;2;150;120;126m",
            "\u001b[38;2;255;241;243m"
        ]
    },
    "modules": [
        { "type": "custom", "format": "{$2}斬月  {$5}\u001b[1mZ A N G E T S U\u001b[0m  {$4}·  TERMINAL ONLINE\u001b[0m" },
        { "type": "custom", "format": "{$1}" },
        { "type": "custom", "format": "{$4}系  SISTEMA\u001b[0m" },
        { "type": "os",       "key": "  󰣇 OS",       "format": "{pretty-name}" },
        { "type": "kernel",   "key": "  󰌽 Kernel",   "format": "{release}" },
        { "type": "packages", "key": "  󰏖 Packages", "format": "{pacman} (pacman)" },
        { "type": "display",  "key": "  󰍹 Display",  "format": "{width}x{height} @ {refresh-rate}Hz" },
        { "type": "wm",       "key": "  󰕮 WM",       "format": "{pretty-name}" },
        { "type": "terminal", "key": "  󰆍 Terminal", "format": "{pretty-name}" },
        { "type": "shell",    "key": "  󰞷 Shell",    "format": "{pretty-name}" },
        "break",
        {
            "type": "title",
            "key": "機 ",
            "keyColor": "38;2;150;120;126",
            "format": "{user-name}{at-symbol-colored}{host-name}",
            "color": { "user": "38;2;255;36;72", "at": "38;2;150;120;126", "host": "38;2;255;36;72" }
        },
        { "type": "cpu",    "key": "  󰻠 CPU",    "keyColor": "38;2;255;36;72", "format": "{name}" },
        { "type": "gpu",    "key": "  󰢮 GPU",    "keyColor": "38;2;255;36;72", "format": "{name}" },
        { "type": "memory", "key": "  󰍛 Memory", "keyColor": "38;2;255;36;72" },
        { "type": "uptime", "key": "  󰥔 Uptime", "keyColor": "38;2;255;36;72" },
        { "type": "custom", "format": "{$1}" },
        // el eclipse: de la luna negra a la corona
        { "type": "custom", "format": "\u001b[38;2;40;8;14m●  \u001b[38;2;110;16;34m●  \u001b[38;2;180;26;52m●  {$2}●  {$3}●  \u001b[38;2;255;190;200m●  {$5}●\u001b[0m   {$4}卍解\u001b[0m" }
    ]
}
