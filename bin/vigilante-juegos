#!/usr/bin/env python3
# Cierra juegos que se quedan colgados al salir (p. ej. Cold War con Proton):
# si el proceso sigue vivo 5 s después de que su ventana desapareció, lo termina.
import json
import os
import re
import signal
import subprocess
import time
from pathlib import Path

# exe del juego -> cómo reconocer su ventana (clase o título)
JUEGOS = {
    "BlackOpsColdWar": re.compile(r"black ?ops|cold ?war|call of duty", re.I),
}
REVISAR_CADA = 3      # segundos
ESPERA_SIN_VENTANA = 5


def procesos(nombre):
    pids = []
    for p in Path("/proc").iterdir():
        if not p.name.isdigit():
            continue
        try:
            # Solo el programa (argv[0]), no los argumentos: así no cuenta una
            # terminal que tenga el nombre del juego escrito en su comando
            prog = (p / "cmdline").read_bytes().split(b"\0")[0].decode(errors="ignore")
        except OSError:
            continue
        exe = re.split(r"[\\/]", prog)[-1].lower()
        if exe in (f"{nombre}.exe".lower(), f"{nombre}crashhandler.exe".lower()):
            pids.append(int(p.name))
    return pids


def hay_ventana(pids, patron):
    out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
    try:
        clients = json.loads(out)
    except ValueError:
        return True  # ante la duda, no matar
    return any(c.get("pid") in pids or patron.search(f"{c.get('class', '')} {c.get('title', '')}")
               for c in clients)


def terminar(pids):
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in pids:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
        time.sleep(3)
        pids = [p for p in pids if Path(f"/proc/{p}").exists()]
        if not pids:
            return


def main():
    vista = {n: False for n in JUEGOS}     # ya vimos su ventana en esta partida
    sin_ventana = {n: None for n in JUEGOS}
    while True:
        time.sleep(REVISAR_CADA)
        for nombre, patron in JUEGOS.items():
            pids = procesos(nombre)
            if not pids:
                vista[nombre], sin_ventana[nombre] = False, None
                continue
            if hay_ventana(pids, patron):
                vista[nombre], sin_ventana[nombre] = True, None
            elif vista[nombre]:
                sin_ventana[nombre] = sin_ventana[nombre] or time.time()
                if time.time() - sin_ventana[nombre] >= ESPERA_SIN_VENTANA:
                    subprocess.run(["notify-send", "-a", "Vigilante", "Juego cerrado",
                                    f"{nombre} se quedó colgado al salir; lo cerré."])
                    terminar(pids)
                    vista[nombre], sin_ventana[nombre] = False, None


if __name__ == "__main__":
    main()
