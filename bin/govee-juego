#!/usr/bin/env python3
# Luces Govee para jugar (Govee LAN API): toman el color de lo que hay en pantalla y destellan con los
# golpes fuertes del audio (explosiones, disparos). Lo prende/apaga solo govee-juego-vigilante.
#   govee-juego [monitor]     monitor a leer (por omisión DP-2, el ASUS)
# Al terminar (SIGTERM / Ctrl+C) regresa las luces como estaban: apagadas, o con su color fijo.
# Ajustes en ~/.config/govee/juego.json (se crea con los valores de abajo).
import json
import math
import os
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

import numpy as np

LUCES = Path.home() / ".config/govee/luces.json"
FIJOS = Path.home() / ".config/govee/fijos.json"
AJUSTES = Path.home() / ".config/govee/juego.json"
DEFAULT = {
    "fps": 12,              # actualizaciones por segundo (la LAN de Govee se atora arriba de ~15)
    "suavizado": 0.35,      # qué tanto se acerca al color nuevo en cada cuadro (1 = de golpe)
    "brillo_min": 0.15,     # brillo en escenas oscuras (0-1)
    "brillo_max": 1.0,      # brillo en escenas claras (0-1)
    "saturacion": 1.4,      # >1 = colores más vivos que la pantalla
    "golpe": 0.6,           # qué tanto suben en un golpe fuerte de audio (0 = sin audio)
    "sensibilidad": 1.6,    # golpe = bajo > este múltiplo de su promedio reciente (menos = más golpes)
    "zonas": {"luz1": "todo", "luz2": "todo"},  # todo / izquierda / derecha / arriba / abajo
}
RATE = 11025


def ajustes():
    try:
        return {**DEFAULT, **json.loads(AJUSTES.read_text())}
    except (OSError, ValueError):
        AJUSTES.parent.mkdir(parents=True, exist_ok=True)
        AJUSTES.write_text(json.dumps(DEFAULT, indent=2) + "\n")
        return dict(DEFAULT)


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def send(ip, cmd, data):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.sendto(json.dumps({"msg": {"cmd": cmd, "data": data}}).encode(), (ip, 4003))
    s.close()


def status(ip):
    rx = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    rx.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    rx.bind(("", 4002))
    rx.settimeout(1.5)
    try:
        send(ip, "devStatus", {})
        return json.loads(rx.recvfrom(4096)[0])["msg"]["data"]
    except (OSError, ValueError, KeyError):
        return None
    finally:
        rx.close()


def color(ip, c):
    send(ip, "colorwc", {"color": {"r": c[0], "g": c[1], "b": c[2]}, "colorTemInKelvin": 0})


def captura(monitor):
    """Pantalla como arreglo (alto, ancho, 3), uno de cada 16 píxeles. Sin escalar en grim: escalar ahí
    cuesta ~100 ms de CPU por cuadro, capturar completo ~16 ms."""
    try:
        raw = subprocess.run(["grim", "-o", monitor, "-t", "ppm", "-"], capture_output=True, timeout=2).stdout
        # cabecera P6: "P6\n<ancho> <alto>\n255\n"
        partes = raw.split(b"\n", 3)
        w, h = map(int, partes[1].split())
        img = np.frombuffer(partes[3], np.uint8, w * h * 3).reshape(h, w, 3)
        return img[::16, ::16].astype(np.float32)
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return None


def zona(img, nombre):
    h, w = img.shape[:2]
    return {"izquierda": img[:, :w // 2], "derecha": img[:, w // 2:],
            "arriba": img[:h // 2], "abajo": img[h // 2:]}.get(nombre, img)


def color_vivo(px, sat):
    """Color representativo: promedio pesado por saturación y brillo (el promedio simple sale gris café)."""
    px = px.reshape(-1, 3)
    mx = px.max(1)
    s = (mx - px.min(1)) / np.maximum(mx, 1)
    peso = s * s * mx + 1e-3
    c = (px * peso[:, None]).sum(0) / peso.sum()
    # más saturación: alejarse del gris del mismo brillo
    gris = c.mean()
    c = gris + (c - gris) * sat
    # brillo de la escena (luminancia media) aparte; el color va normalizado al máximo
    lum = float((px @ np.array([0.2126, 0.7152, 0.0722], np.float32)).mean()) / 255
    c = np.clip(c, 0, None)
    return c / max(c.max(), 1), lum


def main():
    CANDADO = __import__("pathlib").Path.home() / ".config/nero/luces-bloqueadas"  # 11-04: candado (luces-bloqueo on/off)
    if CANDADO.exists():
        sys.exit(0)
    cfg = ajustes()
    luces = json.loads(LUCES.read_text())
    luces = {n: l for n, l in luces.items() if not l.get("aparte")}  # sin la del clóset
    try:
        fijos = json.loads(FIJOS.read_text())
    except (OSError, ValueError):
        fijos = {}
    monitor = sys.argv[1] if len(sys.argv) > 1 else "DP-2"
    antes = {n: status(l["ip"]) for n, l in luces.items()}

    def restaurar(*_):
        trabajo = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"), "modo-trabajo").exists()
        for n, l in luces.items():
            st = antes.get(n)
            if trabajo or (st and not st.get("onOff")):
                send(l["ip"], "turn", {"value": 0})
            else:
                color(l["ip"], rgb(fijos.get(n, "0000ff")))
                if st:
                    send(l["ip"], "brightness", {"value": st.get("brightness", 100)})
        sys.exit(0)

    signal.signal(signal.SIGTERM, restaurar)
    signal.signal(signal.SIGINT, restaurar)
    for l in luces.values():
        send(l["ip"], "turn", {"value": 1})
        send(l["ip"], "brightness", {"value": 100})

    # audio en un hilo aparte: solo deja "golpe" en 1 cuando hay un golpe fuerte de bajo
    estado = {"golpe": 0.0}

    def audio():
        rec = subprocess.Popen(["parec", "-d", "@DEFAULT_MONITOR@", "--format=s16le", f"--rate={RATE}",
                                "--channels=1", "--latency-msec=20"], stdout=subprocess.PIPE)
        a = 1 - math.exp(-2 * math.pi * 150 / RATE)  # paso-bajas ~150 Hz
        lp, pico_b, prom_b = 0.0, 1e-3, 0.0
        bloque = RATE // 40
        while True:
            raw = rec.stdout.read(bloque * 2)
            if not raw:
                return
            x = np.frombuffer(raw, np.int16).astype(np.float32)
            y = np.empty_like(x)
            for i, v in enumerate(x):  # bloque chico (~275 muestras), aguanta en Python
                lp += a * (v - lp)
                y[i] = lp
            rms_b = float(np.sqrt((y * y).mean())) / 32768
            pico_b = max(rms_b, pico_b * 0.998, 1e-3)
            if rms_b / pico_b > 0.5 and rms_b > prom_b * cfg["sensibilidad"] and rms_b > 0.01:
                estado["golpe"] = 1.0
            prom_b = prom_b * 0.95 + rms_b * 0.05

    if cfg["golpe"] > 0:
        threading.Thread(target=audio, daemon=True).start()

    actual = {n: np.array(rgb(fijos.get(n, "0000ff")), np.float32) for n in luces}
    ultimo = {}
    paso = 1 / cfg["fps"]
    while True:
        t0 = time.monotonic()
        img = captura(monitor)
        if img is not None:
            golpe = estado["golpe"]
            estado["golpe"] *= 0.5
            for n, l in luces.items():
                c, lum = color_vivo(zona(img, cfg["zonas"].get(n, "todo")), cfg["saturacion"])
                brillo = cfg["brillo_min"] + (cfg["brillo_max"] - cfg["brillo_min"]) * min(1.0, lum * 2.5)
                brillo = min(1.0, brillo + cfg["golpe"] * golpe)
                obj = c * 255 * brillo
                actual[n] += (obj - actual[n]) * max(cfg["suavizado"], golpe)
                fr = tuple(int(min(255, round(v))) for v in actual[n])
                if ultimo.get(n) != fr:
                    color(l["ip"], fr)
                    ultimo[n] = fr
        time.sleep(max(0.0, paso - (time.monotonic() - t0)))


if __name__ == "__main__":
    main()
