#!/usr/bin/env python3
# Luz del teclado Keychron K2 HE por el protocolo VIA (sin guardar en el teclado: al desconectarlo vuelve a lo normal)
#   teclado-luz off   guarda el brillo actual y lo pone en 0
#   teclado-luz on    regresa el brillo guardado
# Permiso: /etc/udev/rules.d/70-keychron-k2he.rules
import glob, os, select, sys
GUARDADO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "teclado-brillo")

def buscar():
    for h in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            ue = open(h + "/device/uevent").read().upper()
            desc = open(h + "/device/report_descriptor", "rb").read(3)
        except OSError:
            continue
        if "3434" in ue and "0E20" in ue and desc == b"\x06\x60\xff":
            return "/dev/" + os.path.basename(h)
    sys.exit("teclado no encontrado")

fd = os.open(buscar(), os.O_RDWR)
def cmd(*b):
    os.write(fd, bytes([0]) + bytes(b) + bytes(32 - len(b)))
    if select.select([fd], [], [], 1)[0]:
        return os.read(fd, 32)

if sys.argv[1:] == ["off"]:
    actual = cmd(0x08, 3, 1)[3]
    if actual:
        open(GUARDADO, "w").write(str(actual))
    cmd(0x07, 3, 1, 0)
elif sys.argv[1:] == ["on"]:
    try:
        b = int(open(GUARDADO).read())
    except (OSError, ValueError):
        b = 254
    cmd(0x07, 3, 1, b)
else:
    sys.exit("uso: teclado-luz on|off")
