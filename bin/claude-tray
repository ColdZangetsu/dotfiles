#!/usr/bin/env python3
# Icono de Claude en la bandeja del sistema (StatusNotifierItem).
# Clic: muestra/oculta el workspace especial de Claude (igual que Super + C).
import os
import subprocess

from gi.repository import Gio, GLib

ICON_DIR = os.path.expanduser("~/.local/share/icons")
ICON_SVG = os.path.join(ICON_DIR, "hicolor/scalable/apps/claude.svg")
TOGGLE = 'require("utils.functions").toggle("claude")()'

XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
    <signal name="NewIcon"/>
    <signal name="NewStatus"><arg type="s"/></signal>
  </interface>
</node>
"""


def icon_pixmaps():
    """Renderiza el SVG a ARGB32 (big-endian) para bandejas que no buscan por nombre."""
    try:
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
    except (ImportError, ValueError):
        return []
    out = []
    for size in (22, 32, 64):
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(ICON_SVG, size, size)
        except GLib.Error:
            return []
        if not pb.get_has_alpha():
            pb = pb.add_alpha(False, 0, 0, 0)
        w, h, stride = pb.get_width(), pb.get_height(), pb.get_rowstride()
        px = pb.get_pixels()
        data = bytearray()
        for y in range(h):
            row = px[y * stride:y * stride + w * 4]
            for x in range(0, w * 4, 4):
                r, g, b, a = row[x:x + 4]
                data += bytes((a, r, g, b))
        out.append((w, h, bytes(data)))
    return out


PIXMAPS = icon_pixmaps()
PROPS = {
    "Category": GLib.Variant("s", "ApplicationStatus"),
    "Id": GLib.Variant("s", "claude"),
    "Title": GLib.Variant("s", "Claude"),
    "Status": GLib.Variant("s", "Active"),
    "IconName": GLib.Variant("s", "claude"),
    "IconThemePath": GLib.Variant("s", ICON_DIR),
    "IconPixmap": GLib.Variant("a(iiay)", PIXMAPS),
    "ToolTip": GLib.Variant("(sa(iiay)ss)", ("claude", PIXMAPS, "Claude", "Clic para mostrar/ocultar")),
    "ItemIsMenu": GLib.Variant("b", False),
    "Menu": GLib.Variant("o", "/NO_DBUSMENU"),
}


def toggle():
    subprocess.Popen(["hyprctl", "eval", TOGGLE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def on_call(conn, sender, path, iface, method, params, invocation):
    if method in ("Activate", "SecondaryActivate"):
        toggle()
    invocation.return_value(None)


def on_get(conn, sender, path, iface, prop):
    return PROPS.get(prop)


def register(conn, *_):
    conn.call(
        "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
        "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
        GLib.Variant("(s)", (conn.get_unique_name(),)),
        None, Gio.DBusCallFlags.NONE, -1, None, None,
    )


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
    bus.register_object("/StatusNotifierItem", info, on_call, on_get, None)
    # Volver a registrarse cada vez que la barra (el watcher) aparece, p. ej. al reiniciar la shell
    Gio.bus_watch_name_on_connection(
        bus, "org.kde.StatusNotifierWatcher", Gio.BusNameWatcherFlags.NONE,
        lambda c, name, owner: register(bus), None,
    )
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
