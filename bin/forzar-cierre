#!/usr/bin/env python3
# Cierra a la fuerza la ventana activa (para juegos que se cuelgan al salir,
# p. ej. Cold War con Proton). También cierra su CrashHandler si existe.
import json
import os
import re
import signal
import subprocess
import time
from pathlib import Path

win = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"],
                                capture_output=True, text=True).stdout or "{}")
pid = win.get("pid")
if not pid or win.get("class") in ("claude", "kitty"):
    raise SystemExit

pids = [pid]
prog = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[0].decode(errors="ignore")
exe = re.split(r"[\\/]", prog)[-1].lower()
if exe.endswith(".exe"):
    crash = exe[:-4] + "crashhandler.exe"
    for p in Path("/proc").iterdir():
        try:
            if p.name.isdigit() and re.split(r"[\\/]", (p / "cmdline").read_bytes()
                                             .split(b"\0")[0].decode(errors="ignore"))[-1].lower() == crash:
                pids.append(int(p.name))
        except OSError:
            pass

subprocess.run(["notify-send", "-a", "Vigilante", "Cierre forzado", win.get("title", "")[:60]])
for sig in (signal.SIGTERM, signal.SIGKILL):
    for p in pids:
        try:
            os.kill(p, sig)
        except ProcessLookupError:
            pass
    time.sleep(3)
    pids = [p for p in pids if Path(f"/proc/{p}").exists()]
    if not pids:
        break
