#!/usr/bin/env python3
# Solo en modo trabajo (lo lanza modo-trabajo-candado): con el teclado físico apagado en Hyprland,
# Super+Inicio no llega como atajo, así que se lee el Keychron directo del kernel (evdev, sin
# acapararlo) y al ver Super+Inicio corre modo-casa. Cualquier otra tecla se ignora.
# Permiso de lectura: /etc/udev/rules.d/70-keychron-modo-casa.rules (uaccess solo para el Keychron).
import glob
import os
import select
import subprocess
import time

import evdev
from evdev import ecodes

ESTADO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"), "modo-trabajo")
SUPER = {ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}


def teclados():
    devs = []
    for path in glob.glob("/dev/input/by-id/*Keychron*event-kbd"):
        try:
            devs.append(evdev.InputDevice(path))
        except OSError:  # sin permiso todavía o desconectado
            pass
    return devs


def main():
    while os.path.exists(ESTADO):
        devs = teclados()
        if not devs:
            time.sleep(5)
            continue
        try:
            while os.path.exists(ESTADO):
                listos, _, _ = select.select(devs, [], [], 5)
                for d in listos:
                    for ev in d.read():
                        if ev.type == ecodes.EV_KEY and ev.code == ecodes.KEY_HOME and ev.value == 1 \
                                and SUPER & set(d.active_keys()):
                            # Unidad propia: modo-casa detiene el candado (y con él a este script)
                            subprocess.run(["systemd-run", "--user", "--collect", "--unit=modo-casa-tecla-run",
                                            os.path.expanduser("~/.local/bin/modo-casa")])
                            return
        except OSError:  # se desconectó el teclado: volver a buscarlo
            for d in devs:
                try:
                    d.close()
                except OSError:
                    pass
            time.sleep(2)


if __name__ == "__main__":
    main()
