#!/usr/bin/env python3
# Pone un ícono en la bandeja (StatusNotifierItem) mientras haya abierta una
# app web de Brave Origin (YouTube, Crunchyroll), como hacen Discord o Steam.
# Clic izquierdo: enfoca la ventana. Los íconos blancos los pone la barra de
# Caelestia con bar.tray.iconSubs (id "webapp-<nombre>").
import json
import os
import subprocess

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

ICONOS = os.path.expanduser("~/.config/caelestia")
# clase de ventana -> (id, título, ícono)
APPS = {
    "brave-www.youtube.com__-Default": ("youtube", "YouTube", "youtube-tray-white"),
    "brave-www.crunchyroll.com__-Default": ("crunchyroll", "Crunchyroll", "crunchyroll-tray-white"),
}
REVISAR_CADA = 2  # segundos

SNI = "org.kde.StatusNotifierItem"


class Item(dbus.service.Object):
    def __init__(self, clase, ident, titulo, icono):
        # Conexión propia: al cerrarla, la barra quita el ícono
        bus = dbus.SessionBus(private=True)
        self.bus = bus
        self.clase = clase
        self.ident = ident
        self.titulo = titulo
        self.icono = icono
        self.ruta = f"/WebApp/{ident}"
        super().__init__(bus, self.ruta)

    def props(self):
        return {
            "Category": "ApplicationStatus",
            "Id": f"webapp-{self.ident}",
            "Title": self.titulo,
            "Status": "Active",
            "IconName": self.icono,
            "IconThemePath": ICONOS,
            "ItemIsMenu": False,
            "Menu": dbus.ObjectPath("/NO_DBUSMENU"),
            "ToolTip": dbus.Struct(("", dbus.Array([], signature="(iiay)"), self.titulo, ""),
                                   signature="sa(iiay)ss"),
        }

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, iface, prop):
        return self.props()[prop]

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface):
        return self.props()

    @dbus.service.method(SNI, in_signature="ii")
    def Activate(self, x, y):
        direccion = ventana(self.clase)
        if direccion:
            subprocess.run(["hyprctl", "dispatch",
                            f'hl.dsp.focus({{ window = "address:{direccion}" }})'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def cerrar(self):
        self.remove_from_connection()
        self.bus.close()

    @dbus.service.method(SNI, in_signature="ii")
    def SecondaryActivate(self, x, y):
        self.Activate(x, y)

    @dbus.service.method(SNI, in_signature="ii")
    def ContextMenu(self, x, y):
        self.Activate(x, y)

    @dbus.service.method(SNI, in_signature="is")
    def Scroll(self, delta, orientation):
        pass


def ventanas():
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def ventana(clase):
    return next((c["address"] for c in ventanas() or [] if c.get("class") == clase), None)


def main():
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    activos = {}

    def registrar(item):
        try:
            watcher = item.bus.get_object("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher")
            watcher.RegisterStatusNotifierItem(item.ruta,
                                               dbus_interface="org.kde.StatusNotifierWatcher")
        except dbus.DBusException:
            pass  # la barra no está corriendo; se reintenta en la siguiente vuelta
        return False

    def revisar():
        lista = ventanas()
        if lista is None:
            return True
        abiertas = {c.get("class") for c in lista}
        for clase, (ident, titulo, icono) in APPS.items():
            if clase in abiertas and clase not in activos:
                activos[clase] = Item(clase, ident, titulo, icono)
                registrar(activos[clase])
            elif clase not in abiertas and clase in activos:
                activos.pop(clase).cerrar()
        return True

    # Si la barra se reinicia, vuelve a registrar los íconos que sigan abiertos
    def watcher_cambio(nombre, viejo, nuevo):
        if nombre == "org.kde.StatusNotifierWatcher" and nuevo:
            for item in activos.values():
                GLib.timeout_add(500, registrar, item)

    bus.add_signal_receiver(watcher_cambio, "NameOwnerChanged", "org.freedesktop.DBus")
    revisar()
    GLib.timeout_add_seconds(REVISAR_CADA, revisar)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
